# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. The Vercel → Neon integration sets this for you.
# (POSTGRES_URL is also accepted.) Local dev can use postgres://…@localhost/…
DATABASE_URL=

# Secret mixed into every PIN hash. At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never change it after people have signed up (their PINs would stop working).
PIN_PEPPER=

# Invite code required to sign up. Leave empty to close signups completely.
SIGNUP_CODE=
